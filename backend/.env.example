# ── Database ─────────────────────────────────────────────────────────────────
# asyncpg driver — change host/port/user/password/dbname as needed
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/nulltor

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-64-char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Superadmin Seed (first run only) ─────────────────────────────────────────
SUPERADMIN_EMAIL=superadmin@nulltor.local
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=admin123

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=Nulltor
DEBUG=false

# ── Storage ───────────────────────────────────────────────────────────────────
# Where encrypted Yjs snapshots are saved on disk (relative to backend/)
SNAPSHOT_DIR=storage/snapshots

# ── CORS ─────────────────────────────────────────────────────────────────────
# Node.js server origin (where the frontend is served from)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

          "status": 200
        }
      }
    },
    {
      "tool": "reticle_act",
      "anchor": {
        "kind": "role",
        "role": "button",
        "name": "Sign out"
      },
      "args": {},
      "action": "click"
    }
  ],
  "startPath": "/#/login",
  "intent": "Signing in with valid superadmin credentials authenticates and navigates to the dashboard",
  "intentId": "flow:user-signin"

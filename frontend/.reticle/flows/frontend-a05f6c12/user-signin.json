  "steps": [
    {
      "tool": "reticle_act_sequence",
      "anchor": {
        "kind": "role",
        "role": "textbox",
        "name": "Email or Username"
      },
      "steps": [
        {
          "tool": "reticle_act",
          "anchor": {
            "kind": "role",
            "role": "textbox",
            "name": "Email or Username"
          },
          "args": {
            "value": "superadmin@nulltor.com"
          },
          "action": "fill"
        },
        {
          "tool": "reticle_act",
          "anchor": {
            "kind": "role",
            "role": "textbox",
            "name": "Password"
          },
          "args": {
            "value": "admin123"
          },
          "action": "fill"
        }
      ]
    },
    {
      "tool": "reticle_act",
      "anchor": {
        "kind": "role",
        "role": "button",
        "name": "Sign in to Workspace"
      },
      "args": {},
      "action": "click",
      "expect": {
        "net": {

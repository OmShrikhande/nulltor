# Nulltor Configuration
PORT=3330
BACKEND_PORT=8001

# AI Configuration (Used by IDE Copilot Agent)
# Replace with your actual Groq or OpenAI API Key
GROQ_API_KEY=your_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b

# Docker-Sandbox for Terminal (Optional)
# If true, the terminal execution will pull docker containers instead of using local host processes.
USE_DOCKER_SANDBOX=false
